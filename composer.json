{
    "name": "mj-zana/outbox",
    "description": "A transactional outbox and inbox for Zana: events stored with the change they describe, delivered at least once, handled once",
    "type": "library",
    "keywords": [
        "zana",
        "outbox",
        "inbox",
        "events",
        "exactly-once",
        "transactional"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "mj-zana/core": "^2.11",
        "mj-zana/database": "^2.12",
        "mj-zana/ddd": "^2.0",
        "mj-zana/events": "^2.0",
        "psr/event-dispatcher": "^1.0",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "mj-zana/console": "^2.0",
        "mj-zana/testing": "^2.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Zana\\Outbox\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Zana\\Outbox\\Tests\\": "tests/"
        },
        "files": [
            "tests/Fixtures.php"
        ]
    },
    "repositories": [
